{
  "name": "@kylinmoddev/dsh-prompt-refiner",
  "version": "0.6.0",
  "description": "DSH 提示词润色插件（dsh-prompt-refiner）：✨ 一键调用当前模型优化草稿。dsh-prompt-optimizer 的独立增强分支，可与原版并存。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "prompt",
    "prompt-engineering",
    "optimizer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kylinmoddev/dsh-prompt-refiner.git"
  },
  "homepage": "https://github.com/kylinmoddev/dsh-prompt-refiner#readme",
  "bugs": {
    "url": "https://github.com/kylinmoddev/dsh-prompt-refiner/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib",
    "src",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "bundle": "node scripts/build.mjs",
    "gates": "node scripts/gates/run.mjs",
    "test": "node scripts/tests/reasoning-effort.test.mjs",
    "test:fallback": "node scripts/tests/fallback-contract.test.mjs",
    "check": "node scripts/build.mjs && node --check lib/index.js && node --check lib/client.js && node scripts/gates/run.mjs && node scripts/tests/reasoning-effort.test.mjs && node scripts/tests/fallback-contract.test.mjs"
  },
  "engines": {
    "dsh": ">=0.1.7-0",
    "node": ">=18"
  }
}
